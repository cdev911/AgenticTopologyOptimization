{
  "mesh": {
    "kind": "rectangle",
    "bounds": [[0, -5], [10, 5]],
    "divisions": [200, 200],
    "cell_type": "quadrilateral",
    "ghost_mode": "shared_facet"
  },
  "fem": {
    "young's modulus": 100,
    "poisson's ratio": 0.25,
    "disp_bc": "lambda x: np.isclose(x[0], 0) & (np.greater(x[1], 3.5) | np.less(x[1], -3.5))",
    "dirichlet_bcs": [
      {
        "marker": "lambda x: np.isclose(x[0], 0) & (np.greater(x[1], 3.5) | np.less(x[1], -3.5))",
        "value": [0.0, 0.0]
      },
      {
        "marker": "lambda x: np.isclose(x[0], 10) & (np.greater(x[1], 3.5) | np.less(x[1], -3.5))",
        "value": [0.0, 0.0]
      }
    ],
    "traction_bcs": [
      {
        "value": [1.0, 0],
        "locator": "lambda x: np.isclose(x[0], 0) & np.less(x[1], 1.5) & np.greater(x[1], -1.5)"
      }
    ],
    "body_force": [0, 0],
    "quadrature_degree": 2,
    "petsc_options": {
      "ksp_type": "preonly",
      "pc_type": "lu",
      "pc_factor_mat_solver_type": "mumps"
    }
  },
  "parameter_guidance": {
    "max_iter": {
      "description": "Maximum optimization iterations. Must be a positive integer.",
      "type": "integer",
      "minimum": 1
    },
    "vol_frac": {
      "description": "Target volume fraction. Must be between 0 and 1 inclusive.",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "initial_density": {
      "description": "Initial material density assigned to each design variable before optimization. Must be between 0 and 1 inclusive.",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "output_interval": {
      "description": "How often the optimizer writes a history snapshot. Must be a positive integer.",
      "type": "integer",
      "minimum": 1
    },
    "move": {
      "description": "Maximum design update magnitude per iteration. Must be between 0 and 1 inclusive.",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "opt": {
    "max_iter": 500,
    "opt_tol": 1e-5,
    "vol_frac": 0.25,
    "initial_density": 0.25,
    "solid_zone": "lambda x: ((np.less(x[0], 0.5) | np.greater(x[0], 9.5)) & np.less(x[1], 1) & np.greater(x[1], -1))",
    "void_zone": "lambda x: (np.less((x[0]-2.5)**2+(x[1]-3)**2, 0.5**2) | np.less((x[0]-2.5)**2+(x[1]+3)**2, 0.5**2))",
    "penalty": 3.0,
    "epsilon": 1e-6,
    "filter_radius": 0.5,
    "beta_interval": 50,
    "beta_max": 128,
    "use_oc": false,
    "move": 0.05,
    "opt_compliance": false,
    "in_spring": ["lambda x: np.isclose(x[0], 0) & np.less(x[1], 1.5) & np.greater(x[1], -1.5)", "x", 0.2],
    "out_spring": ["lambda x: np.isclose(x[0], 10) & np.less(x[1], 1.5) & np.greater(x[1], -1.5)", "x", 0.2],
    "compliance_bound": 0.5,
    "output_folder": "results",
    "output_prefix": "mechanism_2d",
    "output_interval": 20
  }
}
