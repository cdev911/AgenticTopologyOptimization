      "expected": {"semantic_state": "complete", "boundary_conditions": [{"bc_id": "S1", "kind": "support", "support_kind": "fixed_all", "edge": "left", "selector_kind": "whole_edge"}]},
      "tags": ["synonym"]
    },
    {
      "id": "fix_bottom_edge",
      "family": "support_aliases",
      "purpose": "Retain a whole bottom-edge clamp.",
