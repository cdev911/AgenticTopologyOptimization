        {"bc_id": "S1", "kind": "support", "support_kind": "fixed_all", "edge": "left", "selector_kind": "whole_edge"},
        {"bc_id": "S2", "kind": "support", "support_kind": "fixed_all", "edge": "bottom", "selector_kind": "whole_edge"}
