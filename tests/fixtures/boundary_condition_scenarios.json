      "expected": {"semantic_state": "complete", "boundary_conditions": [{"bc_id": "S1", "kind": "support", "support_kind": "fixed_all", "edge": "top", "selector_kind": "whole_edge"}]},
      "tags": ["whole-edge"]
    },
